# Copy to .env for local development (never commit .env).
# MCP clients normally pass these through their own config instead — see the README.

# Base URL of the Matrix42 instance (required).
M42_HOST=https://matrix42.example.com

# API token created in the Matrix42 Administration application (recommended).
# The server exchanges it for a short-lived access token automatically.
M42_API_TOKEN=

# Basic-auth alternative to M42_API_TOKEN. Discouraged: many instances answer 403
# for basic-auth API access because of role/audience restrictions.
# M42_USERNAME=
# M42_PASSWORD=

# Language for API responses, sent as the Explicit-Language header (default en-US).
# M42_LANGUAGE=de-DE

# Comma-separated tool ids to expose (default: all).
# M42_TOOLS=server_info,webservice_discovery

# Skip TLS certificate verification. Only for self-signed development instances.
# M42_ALLOW_INSECURE_TLS=1

# Per-request timeout in milliseconds (default 30000).
# M42_TIMEOUT_MS=30000

# Mark tickets created through this server with an internal journal note, so a human picking the
# ticket up can see it was raised through the API rather than the web interface. On by default.
# M42_AUDIT_NOTE=0
# M42_AGENT_LABEL=Acme Helpdesk Assistant

# Origin of the web interface, for the links deep_link builds. Left unset it is discovered from the
# instance's own web shell config, which is usually right even when you connect to the API by IP.
# M42_UI_URL=https://matrix42.example.com
