{
  "name": "matrix42-mcp",
  "version": "0.1.2",
  "description": "Model Context Protocol server for Matrix42 — lets AI assistants explore the API, read the data model, search the service desk, and act on tickets",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matrix42-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run build",
    "docs": "npm run build && node scripts/generate-docs.mjs"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "matrix42",
    "itsm",
    "esm",
    "ai",
    "llm",
    "service-desk",
    "itil",
    "matrix42-api",
    "claude",
    "mcp-server"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "author": "S&S Technologies GmbH (https://sus-tech.com/en)",
  "homepage": "https://github.com/sus-tech-gmbh/matrix42-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sus-tech-gmbh/matrix42-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sus-tech-gmbh/matrix42-mcp/issues"
  }
}
