{
  "name": "matrix42-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Matrix42 — lets AI assistants discover and understand the Matrix42 REST API",
  "type": "module",
  "license": "MIT",
  "bin": {
    "matrix42-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "matrix42",
    "itsm",
    "esm",
    "ai",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
